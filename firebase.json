{
  "functions": {
    "source": "backend/functions",
    "runtime": "nodejs18"
  },
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
